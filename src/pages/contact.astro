---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const contactSchema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: 'GenSan GoKart',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'General Santos City',
    addressRegion: 'SOCCSKSARGEN',
    addressCountry: 'PH',
  },
  openingHours: 'Mo-Su 08:00-20:00',
  sameAs: [
    'https://www.facebook.com/gensangokart',
    'https://www.instagram.com/gensangokart',
  ],
};
---

<BaseLayout
  title="Location & Contact — GenSan GoKart"
  description="Find GenSan GoKart in General Santos City. Get directions, opening hours, and contact us on Facebook or Messenger."
>
  <script type="application/ld+json" set:html={JSON.stringify(contactSchema)} slot="head" />
  <Nav />
  <main id="main-content" class="pt-16">
    <div class="bg-gradient-to-br from-brand-red-dark via-brand-dark to-[#1a0505] py-20 px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center">
        <span class="text-brand-orange text-sm font-semibold uppercase tracking-widest">Find Us</span>
        <h1 class="font-display font-black text-brand-cream uppercase mt-2 text-5xl md:text-6xl leading-none">
          Location &amp; <span class="text-brand-yellow">Contact</span>
        </h1>
      </div>
    </div>

    <div class="bg-brand-dark py-16 px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-10">
        <!-- Info -->
        <div class="space-y-8">
          <div>
            <h2 class="font-display font-bold text-brand-yellow uppercase text-xl mb-3">Location</h2>
            <p class="text-brand-cream/75 leading-relaxed">General Santos City, South Cotabato, Philippines</p>
          </div>
          <div>
            <h2 class="font-display font-bold text-brand-yellow uppercase text-xl mb-3">Opening Hours</h2>
            <p class="text-brand-cream/75">Monday – Sunday</p>
            <p class="text-brand-cream font-semibold">8:00 AM – 8:00 PM</p>
          </div>
          <div>
            <h2 class="font-display font-bold text-brand-yellow uppercase text-xl mb-3">Get in Touch</h2>
            <div class="space-y-3">
              <a
                href="https://www.facebook.com/gensangokart"
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center gap-3 text-action-blue hover:text-action-blue-hover transition-colors"
              >
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987H7.9V12h2.538V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z"/>
                </svg>
                Facebook: /gensangokart
              </a>
              <a
                href="https://m.me/gensangokart"
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center gap-3 text-action-blue hover:text-action-blue-hover transition-colors"
              >
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M12 2C6.477 2 2 6.145 2 11.243c0 2.91 1.395 5.506 3.579 7.21V22l3.272-1.797c.874.242 1.8.372 2.749.372 5.523 0 10-4.145 10-9.243C22 6.145 17.523 2 12 2zm1.006 12.433l-2.548-2.72-4.973 2.72 5.472-5.808 2.61 2.72 4.91-2.72-5.471 5.808z"/>
                </svg>
                Message on Messenger
              </a>
              <a
                href="https://www.instagram.com/gensangokart"
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center gap-3 text-action-blue hover:text-action-blue-hover transition-colors"
              >
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M12.315 2c2.43 0 2.784.013 3.808.06 1.064.049 1.791.218 2.427.465a4.902 4.902 0 011.772 1.153 4.902 4.902 0 011.153 1.772c.247.636.416 1.363.465 2.427.048 1.067.06 1.407.06 4.123v.08c0 2.643-.012 2.987-.06 4.043-.049 1.064-.218 1.791-.465 2.427a4.902 4.902 0 01-1.153 1.772 4.902 4.902 0 01-1.772 1.153c-.636.247-1.363.416-2.427.465-1.067.048-1.407.06-4.123.06h-.08c-2.643 0-2.987-.012-4.043-.06-1.064-.049-1.791-.218-2.427-.465a4.902 4.902 0 01-1.772-1.153 4.902 4.902 0 01-1.153-1.772c-.247-.636-.416-1.363-.465-2.427-.047-1.024-.06-1.379-.06-3.808v-.63c0-2.43.013-2.784.06-3.808.049-1.064.218-1.791.465-2.427a4.902 4.902 0 011.153-1.772A4.902 4.902 0 015.45 2.525c.636-.247 1.363-.416 2.427-.465C8.901 2.013 9.256 2 11.685 2h.63zm-.081 1.802h-.468c-2.456 0-2.784.011-3.807.058-.975.045-1.504.207-1.857.344-.467.182-.8.398-1.15.748-.35.35-.566.683-.748 1.15-.137.353-.3.882-.344 1.857-.047 1.023-.058 1.351-.058 3.807v.468c0 2.456.011 2.784.058 3.807.045.975.207 1.504.344 1.857.182.466.399.8.748 1.15.35.35.683.566 1.15.748.353.137.882.3 1.857.344 1.054.048 1.37.058 4.041.058h.08c2.597 0 2.917-.01 3.96-.058.976-.045 1.505-.207 1.858-.344.466-.182.8-.398 1.15-.748.35-.35.566-.683.748-1.15.137-.353.3-.882.344-1.857.048-1.055.058-1.37.058-4.041v-.08c0-2.597-.01-2.917-.058-3.96-.045-.976-.207-1.505-.344-1.858a3.097 3.097 0 00-.748-1.15 3.098 3.098 0 00-1.15-.748c-.353-.137-.882-.3-1.857-.344-1.023-.047-1.351-.058-3.807-.058zM12 6.865a5.135 5.135 0 110 10.27 5.135 5.135 0 010-10.27zm0 1.802a3.333 3.333 0 100 6.666 3.333 3.333 0 000-6.666zm5.338-3.205a1.2 1.2 0 110 2.4 1.2 1.2 0 010-2.4z"/>
                </svg>
                Instagram: @gensangokart
              </a>
            </div>
          </div>
          <a
            href="/booking"
            class="inline-flex items-center bg-action-blue hover:bg-action-blue-hover text-white font-bold px-6 py-3 rounded-lg transition-colors"
          >
            Book a Ride
          </a>
        </div>

        <!-- Map placeholder -->
        <div class="rounded-2xl overflow-hidden bg-brand-red-dark/15 border border-brand-red/20 h-80 flex items-center justify-center">
          <div class="text-center p-6">
            <p class="text-brand-muted text-sm mb-3">Interactive map coming soon.</p>
            <a
              href="https://maps.google.com/?q=General+Santos+City+GoKart"
              target="_blank"
              rel="noopener noreferrer"
              class="text-action-blue hover:underline text-sm font-semibold"
            >
              Open in Google Maps →
            </a>
          </div>
        </div>
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>
