---
import footBg from '../assets/images/gsgk-foot-bg-dirt.jpg';
import logoSrc from '../assets/images/logo-with-text.png';
const year = new Date().getFullYear();
---

<footer class="relative overflow-hidden border-t border-brand-red/30 pt-12 pb-6">
  <!-- Background photo -->
  <img
    src={footBg.src}
    alt=""
    width={footBg.width}
    height={footBg.height}
    class="absolute inset-0 w-full h-full object-cover object-center"
    loading="lazy"
  />
  <!-- Dark overlay so text stays readable -->
  <div class="absolute inset-0 bg-brand-dark/85"></div>
  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- CTA banner -->
    <div class="text-center mb-10">
      <p class="font-display text-brand-yellow text-3xl md:text-4xl font-black uppercase tracking-tight mb-4">
        Ready to Hit the Track?
      </p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a
          href="/booking"
          class="inline-flex items-center justify-center bg-action-blue hover:bg-action-blue-hover text-white font-semibold px-6 py-3 rounded transition-colors"
          onclick="gtag?.('event','book_now_click',{location:'footer'})"
        >
          Book Your Ride
        </a>
        <a
          href="https://m.me/gensangokart"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center border border-brand-cream/30 hover:border-brand-yellow text-brand-cream hover:text-brand-yellow font-semibold px-6 py-3 rounded transition-colors"
        >
          Message on Messenger
        </a>
      </div>
    </div>

    <hr class="border-brand-red/20 mb-8" />

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-8">
      <!-- Brand -->
      <div>
        <div class="mb-3">
          <img
            src={logoSrc.src}
            alt="GenSan GoKart"
            width={logoSrc.width}
            height={logoSrc.height}
            class="h-10 w-auto object-contain"
            loading="lazy"
          />
        </div>
        <p class="text-brand-muted text-sm leading-relaxed">
          General Santos City's premier off-road go-kart experience. Family-friendly, beginner-safe, adrenaline-guaranteed.
        </p>
      </div>

      <!-- Links -->
      <div>
        <h3 class="text-brand-cream font-semibold text-sm uppercase tracking-widest mb-3">Quick Links</h3>
        <ul class="space-y-2 text-sm" role="list">
          {[
            { href: '/packages', label: 'Packages & Pricing' },
            { href: '/booking', label: 'Book a Ride' },
            { href: '/about', label: 'About the Experience' },
            { href: '/events', label: 'Upcoming Events' },
            { href: '/contact', label: 'Location & Contact' },
          ].map(({ href, label }) => (
            <li>
              <a href={href} class="text-brand-muted hover:text-action-blue transition-colors">{label}</a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Social & Contact -->
      <div>
        <h3 class="text-brand-cream font-semibold text-sm uppercase tracking-widest mb-3">Find Us</h3>
        <p class="text-brand-muted text-sm mb-3">General Santos City, South Cotabato, Philippines</p>
        <div class="flex gap-3">
          <a
            href="https://www.facebook.com/gensangokart"
            target="_blank"
            rel="noopener noreferrer"
            class="text-brand-muted hover:text-action-blue transition-colors"
            aria-label="Facebook"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987H7.9V12h2.538V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z"/>
            </svg>
          </a>
          <a
            href="https://www.instagram.com/gensangokart"
            target="_blank"
            rel="noopener noreferrer"
            class="text-brand-muted hover:text-action-blue transition-colors"
            aria-label="Instagram"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12.315 2c2.43 0 2.784.013 3.808.06 1.064.049 1.791.218 2.427.465a4.902 4.902 0 011.772 1.153 4.902 4.902 0 011.153 1.772c.247.636.416 1.363.465 2.427.048 1.067.06 1.407.06 4.123v.08c0 2.643-.012 2.987-.06 4.043-.049 1.064-.218 1.791-.465 2.427a4.902 4.902 0 01-1.153 1.772 4.902 4.902 0 01-1.772 1.153c-.636.247-1.363.416-2.427.465-1.067.048-1.407.06-4.123.06h-.08c-2.643 0-2.987-.012-4.043-.06-1.064-.049-1.791-.218-2.427-.465a4.902 4.902 0 01-1.772-1.153 4.902 4.902 0 01-1.153-1.772c-.247-.636-.416-1.363-.465-2.427-.047-1.024-.06-1.379-.06-3.808v-.63c0-2.43.013-2.784.06-3.808.049-1.064.218-1.791.465-2.427a4.902 4.902 0 011.153-1.772A4.902 4.902 0 015.45 2.525c.636-.247 1.363-.416 2.427-.465C8.901 2.013 9.256 2 11.685 2h.63zm-.081 1.802h-.468c-2.456 0-2.784.011-3.807.058-.975.045-1.504.207-1.857.344-.467.182-.8.398-1.15.748-.35.35-.566.683-.748 1.15-.137.353-.3.882-.344 1.857-.047 1.023-.058 1.351-.058 3.807v.468c0 2.456.011 2.784.058 3.807.045.975.207 1.504.344 1.857.182.466.399.8.748 1.15.35.35.683.566 1.15.748.353.137.882.3 1.857.344 1.054.048 1.37.058 4.041.058h.08c2.597 0 2.917-.01 3.96-.058.976-.045 1.505-.207 1.858-.344.466-.182.8-.398 1.15-.748.35-.35.566-.683.748-1.15.137-.353.3-.882.344-1.857.048-1.055.058-1.37.058-4.041v-.08c0-2.597-.01-2.917-.058-3.96-.045-.976-.207-1.505-.344-1.858a3.097 3.097 0 00-.748-1.15 3.098 3.098 0 00-1.15-.748c-.353-.137-.882-.3-1.857-.344-1.023-.047-1.351-.058-3.807-.058zM12 6.865a5.135 5.135 0 110 10.27 5.135 5.135 0 010-10.27zm0 1.802a3.333 3.333 0 100 6.666 3.333 3.333 0 000-6.666zm5.338-3.205a1.2 1.2 0 110 2.4 1.2 1.2 0 010-2.4z"/>
            </svg>
          </a>
          <a
            href="https://m.me/gensangokart"
            target="_blank"
            rel="noopener noreferrer"
            class="text-brand-muted hover:text-action-blue transition-colors"
            aria-label="Messenger"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 2C6.477 2 2 6.145 2 11.243c0 2.91 1.395 5.506 3.579 7.21V22l3.272-1.797c.874.242 1.8.372 2.749.372 5.523 0 10-4.145 10-9.243C22 6.145 17.523 2 12 2zm1.006 12.433l-2.548-2.72-4.973 2.72 5.472-5.808 2.61 2.72 4.91-2.72-5.471 5.808z"/>
            </svg>
          </a>
        </div>
      </div>
    </div>

    <hr class="border-brand-red/20 mb-4" />
    <p class="text-center text-brand-muted text-xs">
      &copy; {year} GenSan GoKart. All rights reserved.
    </p>
  </div>
</footer>
