---
const features = [
  {
    id: 'dirt',
    title: 'Off-Road Dirt Racing',
    desc: 'Feel the grip of real dirt tracks. Corners, jumps, and raw speed — not a sterile circuit.',
  },
  {
    id: 'family',
    title: 'Family Bonding',
    desc: 'Safe for beginners and young riders. Create memories your family will replay forever.',
  },
  {
    id: 'barkada',
    title: 'Barkada Challenge',
    desc: 'Race your crew. Trash-talk freely. Settle it on the track like adults.',
  },
  {
    id: 'team',
    title: 'Team Building',
    desc: 'Corporate event or company outing? Nothing builds teamwork faster than competing together.',
  },
];
---

<section class="bg-gradient-to-b from-brand-dark to-[#1f0d09] py-20 px-4 sm:px-6 lg:px-8" aria-labelledby="experience-heading">
  <div class="max-w-7xl mx-auto">
    <div class="text-center mb-12">
      <span class="text-brand-orange text-sm font-semibold uppercase tracking-widest">What You'll Experience</span>
      <h2 id="experience-heading" class="font-display font-black text-brand-cream uppercase mt-2 text-4xl md:text-5xl leading-none">
        Built for Every<br />
        <span class="text-brand-yellow">Rider Type</span>
      </h2>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {features.map(({ id, title, desc }) => (
        <div class="exp-card group relative overflow-hidden bg-brand-red-dark/20 border border-brand-red/20 hover:border-brand-orange/40 rounded-2xl p-6 transition-all duration-300 hover:bg-brand-red/20 hover:-translate-y-1">
          <div class="relative w-20 h-20 mb-5 flex items-center justify-center" aria-hidden="true">
            <span class="absolute inset-0 rounded-full bg-brand-orange/25 blur-md"></span>
            <span class="absolute inset-2 rounded-full bg-brand-orange/15"></span>
            <div class="relative w-12 h-12 text-brand-orange">
              {id === 'dirt' && (
                <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-full">
                  <circle cx="14" cy="44" r="5" fill="#FFC928" opacity="0.35" />
                  <circle cx="8" cy="50" r="3.5" fill="#FFC928" opacity="0.25" />
                  <circle cx="20" cy="52" r="4" fill="#FFC928" opacity="0.3" />
                  <path d="M6 38 L14 36" stroke="#FFC928" stroke-width="2" stroke-linecap="round" opacity="0.6" />
                  <path d="M4 44 L12 43" stroke="#FFC928" stroke-width="2" stroke-linecap="round" opacity="0.45" />
                  <circle cx="40" cy="36" r="18" stroke="#FF6A1A" stroke-width="3" fill="#2A120D" />
                  <g stroke="#FF6A1A" stroke-width="2" stroke-linecap="round">
                    <line x1="40" y1="20" x2="40" y2="24" />
                    <line x1="40" y1="48" x2="40" y2="52" />
                    <line x1="24" y1="36" x2="28" y2="36" />
                    <line x1="52" y1="36" x2="56" y2="36" />
                    <line x1="29" y1="25" x2="31.5" y2="27.5" />
                    <line x1="48.5" y1="44.5" x2="51" y2="47" />
                    <line x1="29" y1="47" x2="31.5" y2="44.5" />
                    <line x1="48.5" y1="27.5" x2="51" y2="25" />
                  </g>
                  <circle cx="40" cy="36" r="5" fill="#FFC928" />
                  <circle cx="40" cy="36" r="2" fill="#2A120D" />
                </svg>
              )}
              {id === 'family' && (
                <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-full">
                  <line x1="4" y1="54" x2="60" y2="54" stroke="#FFC928" stroke-width="1.5" stroke-dasharray="3 3" opacity="0.5" />
                  <path d="M6 44 L10 36 L24 36 L26 44 Z" fill="#FF6A1A" />
                  <rect x="12" y="30" width="8" height="8" rx="2" fill="#FFC928" />
                  <circle cx="16" cy="26" r="3.5" fill="#FFF4E8" stroke="#2A120D" stroke-width="1.5" />
                  <circle cx="10" cy="46" r="3" fill="#2A120D" />
                  <circle cx="22" cy="46" r="3" fill="#2A120D" />
                  <path d="M38 44 L42 36 L56 36 L58 44 Z" fill="#FFC928" />
                  <rect x="44" y="30" width="8" height="8" rx="2" fill="#FF6A1A" />
                  <circle cx="48" cy="26" r="3.5" fill="#FFF4E8" stroke="#2A120D" stroke-width="1.5" />
                  <circle cx="42" cy="46" r="3" fill="#2A120D" />
                  <circle cx="54" cy="46" r="3" fill="#2A120D" />
                  <path d="M32 18 C30 14, 26 16, 28 20 L32 24 L36 20 C38 16, 34 14, 32 18 Z" fill="#FF6A1A" />
                </svg>
              )}
              {id === 'barkada' && (
                <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-full">
                  <g stroke="#FFC928" stroke-width="2.5" stroke-linecap="round">
                    <line x1="4" y1="20" x2="14" y2="20" />
                    <line x1="2" y1="32" x2="16" y2="32" opacity="0.8" />
                    <line x1="4" y1="44" x2="14" y2="44" opacity="0.6" />
                  </g>
                  <line x1="22" y1="8" x2="22" y2="58" stroke="#2A120D" stroke-width="2.5" stroke-linecap="round" />
                  <g>
                    <rect x="24" y="10" width="8" height="8" fill="#FFF4E8" />
                    <rect x="32" y="10" width="8" height="8" fill="#2A120D" />
                    <rect x="40" y="10" width="8" height="8" fill="#FFF4E8" />
                    <rect x="48" y="10" width="8" height="8" fill="#2A120D" />
                    <rect x="24" y="18" width="8" height="8" fill="#2A120D" />
                    <rect x="32" y="18" width="8" height="8" fill="#FFF4E8" />
                    <rect x="40" y="18" width="8" height="8" fill="#2A120D" />
                    <rect x="48" y="18" width="8" height="8" fill="#FFF4E8" />
                    <rect x="24" y="26" width="8" height="8" fill="#FFF4E8" />
                    <rect x="32" y="26" width="8" height="8" fill="#2A120D" />
                    <rect x="40" y="26" width="8" height="8" fill="#FFF4E8" />
                    <rect x="48" y="26" width="8" height="8" fill="#2A120D" />
                  </g>
                  <rect x="24" y="10" width="32" height="24" stroke="#FF6A1A" stroke-width="2" fill="none" />
                </svg>
              )}
              {id === 'team' && (
                <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-full">
                  <path d="M22 8 L42 8 L40 28 C40 33, 36 36, 32 36 C28 36, 24 33, 24 28 Z" fill="#FFC928" stroke="#FF6A1A" stroke-width="2" />
                  <path d="M22 12 C16 12, 14 18, 18 22" stroke="#FF6A1A" stroke-width="2" fill="none" stroke-linecap="round" />
                  <path d="M42 12 C48 12, 50 18, 46 22" stroke="#FF6A1A" stroke-width="2" fill="none" stroke-linecap="round" />
                  <line x1="26" y1="14" x2="38" y2="14" stroke="#FF6A1A" stroke-width="1.5" />
                  <line x1="26" y1="18" x2="38" y2="18" stroke="#2A120D" stroke-width="1.5" />
                  <rect x="30" y="36" width="4" height="6" fill="#FF6A1A" />
                  <rect x="24" y="42" width="16" height="16" fill="#FF6A1A" />
                  <text x="32" y="54" font-family="Arial Black, sans-serif" font-size="10" font-weight="900" text-anchor="middle" fill="#FFF4E8">1</text>
                  <rect x="8" y="48" width="16" height="10" fill="#FFC928" />
                  <rect x="40" y="50" width="16" height="8" fill="#FFC928" opacity="0.7" />
                </svg>
              )}
            </div>
          </div>
          <h3 class="font-display font-bold text-brand-yellow uppercase text-xl leading-tight mb-2">{title}</h3>
          <p class="text-brand-cream/65 text-sm leading-relaxed">{desc}</p>
          <span class="exp-stripe absolute bottom-0 left-0 h-[3px] bg-brand-orange"></span>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .exp-card .exp-stripe {
    width: 2.5rem;
    transition: width 450ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .exp-card:hover .exp-stripe,
  .exp-card:focus-within .exp-stripe {
    width: 100%;
  }
</style>
